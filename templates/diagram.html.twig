{#
 # Workflow diagram (spec 002). The component reads its configuration from
 # `data-config`, see js/diagram/main.tsx.
 #}
{% if bundle_url is null %}
    {# Only administrators get the hint; the ticket tab just has no diagram. #}
    {% if build_hint %}
        <div class="alert alert-warning">
            {{ __('The diagram is not built. Run npm install in the plugin directory.', 'flowtask') }}
        </div>
    {% endif %}
{% else %}
    {% set diagram_id = 'flowtask-diagram-' ~ random() %}
    {# Loaded before the component, which needs the height to fit the view. #}
    <link rel="stylesheet" href="{{ stylesheet_url }}">
    <div id="{{ diagram_id }}" class="flowtask-diagram card mb-3" style="height: {{ height }}px;" data-config="{{ config|json_encode }}"></div>
    <script>
        import('{{ bundle_url|e('js') }}').then((module) => module.mount(document.getElementById('{{ diagram_id }}')));
    </script>
{% endif %}
