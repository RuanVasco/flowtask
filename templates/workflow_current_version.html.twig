{#
 # Current version of a workflow and the actions on it (spec 001,
 # definition management rules). Each action is its own form, outside the
 # workflow form.
 #}
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="flex-grow-1">
            {% if draft is not null %}
                <span class="badge bg-orange-lt">{{ __('Draft', 'flowtask') }}</span>
                {{ __('Version %d', 'flowtask')|format(draft.fields['version_number']) }}
                <div class="text-secondary small">
                    {% if published is not null %}
                        {{ __('New tickets keep using version %d until this draft is published.', 'flowtask')|format(published.fields['version_number']) }}
                    {% else %}
                        {{ __('New tickets will not start this workflow until it is published.', 'flowtask') }}
                    {% endif %}
                </div>
            {% elseif published is not null %}
                <span class="badge bg-green-lt">{{ __('Published', 'flowtask') }}</span>
                {{ __('Version %d', 'flowtask')|format(published.fields['version_number']) }}
                <div class="text-secondary small">
                    {{ __('Published on %1$s by %2$s.', 'flowtask')|format(published.fields['date_publication']|formatted_datetime, publisher) }}
                </div>
            {% else %}
                <span class="text-secondary">{{ __('This workflow has no version yet.', 'flowtask') }}</span>
            {% endif %}
        </div>

        {% if canedit %}
            {% if draft is not null %}
                <form method="post" action="{{ publish_url }}">
                    <button type="submit" name="publish" value="1" class="btn btn-success">
                        <i class="ti ti-rocket"></i>
                        <span>{{ __('Publish', 'flowtask') }}</span>
                    </button>
                </form>
                <form method="post" action="{{ version_form_url }}">
                    <input type="hidden" name="id" value="{{ draft.getID() }}">
                    <button type="submit" name="purge" value="1" class="btn btn-outline-danger"
                            onclick="return confirm('{{ __('Discard this draft and its changes?', 'flowtask')|e('js') }}');">
                        <i class="ti ti-trash"></i>
                        <span>{{ __('Discard draft', 'flowtask') }}</span>
                    </button>
                </form>
            {% else %}
                <form method="post" action="{{ version_form_url }}">
                    <input type="hidden" name="{{ workflow_field }}" value="{{ workflow_id }}">
                    <button type="submit" name="add" value="1" class="btn btn-primary">
                        <i class="ti ti-pencil"></i>
                        <span>{{ __('Edit', 'flowtask') }}</span>
                    </button>
                </form>
            {% endif %}
        {% endif %}
    </div>
</div>
