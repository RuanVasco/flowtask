{% import 'components/form/fields_macros.html.twig' as fields %}

{% if canedit %}
    <form method="post" action="{{ form_url }}" class="mb-3">
        <input type="hidden" name="{{ workflow_field }}" value="{{ workflow_id }}">
        <div class="d-flex align-items-end gap-2">
            {{ fields.dropdownField('ITILCategory', category_field, 0, 'ITILCategory'|itemtype_name, dropdown_options|merge({
                'field_class': 'col-12 col-sm-6',
                'mb': '',
            })) }}
            <button type="submit" name="add" value="1" class="btn btn-primary">
                <i class="ti ti-link"></i>
                <span>{{ _x('button', 'Add') }}</span>
            </button>
        </div>
    </form>
{% endif %}

{{ include('components/datatable.html.twig', {
    'is_tab': true,
    'nofilter': true,
    'nosort': true,
    'columns': columns,
    'formatters': formatters,
    'entries': entries,
    'total_number': entries|length,
    'showmassiveactions': canedit,
    'massiveactionparams': massive_params,
}, with_context = false) }}
