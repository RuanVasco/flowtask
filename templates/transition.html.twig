{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% if item.isNewItem() %}
        {{ fields.hiddenField('plugin_flowtask_workflowversions_id', item.fields['plugin_flowtask_workflowversions_id']) }}
    {% endif %}
    {{ fields.htmlField('', version_link, _n('Workflow version', 'Workflow versions', 1, 'flowtask')) }}
    {{ fields.dropdownArrayField('plugin_flowtask_nodes_id_source', item.fields['plugin_flowtask_nodes_id_source'], sources, __('From step', 'flowtask'), field_options) }}
    {{ fields.dropdownArrayField('trigger_condition', item.fields['trigger_condition'], conditions, __('Condition', 'flowtask'), field_options|merge({
        'helper': __('Start steps fire "Always", task steps "Completed", approval steps "Approved" or "Rejected".', 'flowtask'),
    })) }}
    {{ fields.dropdownArrayField('plugin_flowtask_nodes_id_target', item.fields['plugin_flowtask_nodes_id_target'], targets, __('To step', 'flowtask'), field_options) }}
{% endblock %}
