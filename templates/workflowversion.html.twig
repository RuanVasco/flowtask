{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {% if item.isNewItem() %}
        {{ fields.hiddenField('plugin_flowtask_workflows_id', item.fields['plugin_flowtask_workflows_id']) }}
    {% else %}
        {{ fields.htmlField('', workflow_link, _n('Workflow', 'Workflows', 1, 'flowtask')) }}
        {{ fields.htmlField('', item.fields['version_number'], __('Version number', 'flowtask')) }}
        {{ fields.htmlField('', status_label|e, __('Status')) }}
        {% if publisher is not empty %}
            {{ fields.htmlField('', publisher|e, __('Published by', 'flowtask')) }}
            {{ fields.htmlField('', item.fields['date_publication']|formatted_datetime, __('Publication date', 'flowtask')) }}
        {% endif %}
    {% endif %}
    {{ fields.textareaField('comment', item.fields['comment'], _n('Comment', 'Comments', 1), field_options|merge({'disabled': not item.isDraft()})) }}
    {% if publish_url is not null %}
        {{ fields.htmlField('', include('@flowtask/publish_button.html.twig', {'publish_url': publish_url}), '') }}
    {% endif %}
{% endblock %}
