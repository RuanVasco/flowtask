{% if readonly|default(false) %}
    <div class="alert alert-info">
        {{ __('Only a draft can be changed. Use "Edit" on the workflow to create one.', 'flowtask') }}
    </div>
{% endif %}

{% if add_url is not null %}
    <div class="mb-3">
        <a href="{{ add_url }}" class="btn btn-primary">
            <i class="ti ti-plus"></i>
            <span>{{ add_label }}</span>
        </a>
    </div>
{% endif %}

{{ include('components/datatable.html.twig', {
    'is_tab': true,
    'nofilter': true,
    'nosort': true,
    'columns': columns,
    'formatters': formatters,
    'entries': entries,
    'total_number': entries|length,
}, with_context = false) }}
