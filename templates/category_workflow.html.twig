{% import 'components/form/fields_macros.html.twig' as fields %}

{% if workflow is not null %}
    <div class="card">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <i class="{{ workflow.getIcon() }} fs-1"></i>
            <div class="flex-grow-1">
                <div class="fw-bold">{{ workflow.getLink()|raw }}</div>
                <div class="text-secondary small">
                    {% if not workflow.fields['is_active'] %}
                        <span class="badge bg-secondary-lt">{{ __('Inactive', 'flowtask') }}</span>
                    {% endif %}
                    {% if status_label is not empty %}
                        {{ __('Version %1$d (%2$s), %3$d steps', 'flowtask')|format(version_number, status_label, step_count) }}
                    {% else %}
                        {{ __('This workflow has no version yet.', 'flowtask') }}
                    {% endif %}
                </div>
            </div>
            <a href="{{ workflow.getLinkURL() }}" class="btn btn-primary">
                <i class="ti ti-pencil"></i>
                <span>{{ __('Open workflow', 'flowtask') }}</span>
            </a>
            {% if can_unlink %}
                <form method="post" action="{{ link_url }}">
                    <input type="hidden" name="id" value="{{ link_id }}">
                    <button type="submit" name="purge" value="1" class="btn btn-outline-secondary">
                        <i class="ti ti-unlink"></i>
                        <span>{{ __('Unlink', 'flowtask') }}</span>
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
{% elseif hidden_link %}
    <div class="alert alert-info">
        {{ __('Tickets in this category start a workflow from an entity you cannot see.', 'flowtask') }}
    </div>
{% else %}
    <div class="alert alert-info">
        {{ __('Tickets in this category do not start any workflow.', 'flowtask') }}
    </div>

    {% if can_create %}
        <form method="post" action="{{ workflow_url }}" class="card mb-3">
            <div class="card-body">
                <input type="hidden" name="entities_id" value="{{ category.fields['entities_id'] }}">
                <input type="hidden" name="is_recursive" value="{{ category.fields['is_recursive'] }}">
                <input type="hidden" name="is_active" value="1">
                <input type="hidden" name="_itilcategories_id" value="{{ category.getID() }}">
                <div class="d-flex align-items-end gap-2">
                    {{ fields.textField('name', category.fields['name'], __('Name'), {
                        'field_class': 'col-12 col-sm-6',
                        'mb': '',
                    }) }}
                    <button type="submit" name="add" value="1" class="btn btn-primary">
                        <i class="ti ti-plus"></i>
                        <span>{{ __('Create a workflow for this category', 'flowtask') }}</span>
                    </button>
                </div>
            </div>
        </form>
    {% endif %}

    {% if can_link %}
        <form method="post" action="{{ link_url }}" class="card">
            <div class="card-body">
                <input type="hidden" name="{{ category_field }}" value="{{ category.getID() }}">
                <div class="d-flex align-items-end gap-2">
                    {{ fields.dropdownField(workflow_itemtype, workflow_field, 0, __('Or use an existing workflow', 'flowtask'), {
                        'entity': category.fields['entities_id'],
                        'field_class': 'col-12 col-sm-6',
                        'mb': '',
                    }) }}
                    <button type="submit" name="add" value="1" class="btn btn-outline-primary">
                        <i class="ti ti-link"></i>
                        <span>{{ _x('button', 'Add') }}</span>
                    </button>
                </div>
            </div>
        </form>
    {% endif %}
{% endif %}
